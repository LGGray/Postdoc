source_file": "ASE/Allelome_LINK.analysis.R", "source_location": "L76", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "ase_allelome_link_analysis_adult_allelome_link_rdata", "label": "adult.Allelome.LINK.RData", "file_type": "code", "source_file": "ASE/Allelome_LINK.analysis.R", "source_location": "L198", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "ase_allelome_link_analysis_aged_allelome_link_rdata", "label": "aged.Allelome.LINK.RData", "file_type": "code", "source_file": "ASE/Allelome_LINK.analysis.R", "source_location": "L221", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "ase_allelome_link_analysis_mouse_cpg_clock_txt", "label": "Mouse.CpG.clock.txt", "file_type": "code", "source_file": "ASE/Allelome_LINK.analysis.R", "source_location": "L721", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "ase_allelome_link_analysis_grcm39_refseq_gtf", "label": "GRCm39/GCF_000001635.27_GRCm39_genomic.gtf (RefSeq)", "file_type": "code", "source_file": "ASE/Allelome_LINK.analysis.R", "source_location": "L19", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "ase_allelome_link_analysis_mechanism_match_perm_results_txt", "label": "figures/mechanism_match_perm_results.txt", "file_type": "code", "source_file": "ASE/Allelome_LINK.analysis.R", "source_location": "L591", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "ase_allelome_link_analysis_ggalluvial_package", "label": "ggalluvial (link state transition flows)", "file_type": "concept", "source_file": "ASE/Allelome_LINK.analysis.R", "source_location": "L9", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "ase_allelome_link_analysis_allelic_ratio_concept", "label": "Allelic Ratio (ASE)", "file_type": "rationale", "source_file": "ASE/Allelome_LINK.analysis.R", "source_location": "L109", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Genes are called allele-specific when allelic_ratio <= 0.3 or >= 0.7 for the autosomal survey, but downstream link work uses a looser 0.35/0.65 window and a 0.65/0.70 reference threshold family. The dual thresholds exist because the ASE prevalence figure is descriptive (wide, conservative cut) while link calling must retain borderline-biased loci so that loss of bias can be distinguished from loss of expression."}, {"id": "ase_allelome_link_analysis_link_mechanism_concept", "label": "Link Mechanism (enhancing vs repressing)", "file_type": "rationale", "source_file": "ASE/Allelome_LINK.analysis.R", "source_location": "L242", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Every link carries a mechanism label so a lncRNA base and its pcGene target are treated as a directed pair. Mechanism is folded into the link identity key (base|target|mechanism) rather than kept as an attribute, which makes a mechanism flip register as a simultaneous loss and gain rather than a modified edge."}, {"id": "ase_allelome_link_analysis_gained_lost_retained_concept", "label": "Gained / Lost / Retained Link Classification", "file_type": "rationale", "source_file": "ASE/Allelome_LINK.analysis.R", "source_location": "L280", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Links are partitioned by set difference between adult and aged rather than by a statistical test, because there is no replicate structure at the link level. Concordance with expression fold change and a mechanism-shuffling permutation null are used instead to show the gains and losses are not arbitrary."}, {"id": "ase_allelome_link_analysis_mechanism_permutation_concept", "label": "Mechanism-Shuffling Permutation Null", "file_type": "rationale", "source_file": "ASE/Allelome_LINK.analysis.R", "source_location": "L540", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Only the mechanism labels are permuted, deliberately preserving base/target identity and their fold changes. This isolates the question 'is the enhancing/repressing call informative?' from confounding by which genes happen to be differentially expressed."}, {"id": "ase_allelome_link_analysis_expression_vs_mechanism_loss_concept", "label": "Expression Loss vs Mechanism Loss", "file_type": "rationale", "source_file": "ASE/Allelome_LINK.analysis.R", "source_location": "L611", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "A disappeared link is triaged into expression_loss (gene undetected or below a 50-read floor) versus mechanism_loss (gene still expressed but allelic ratio returned to balance). Without this split, links lost purely to dropout at low depth would be misread as genuine regulatory rewiring."}], "edges": [{"source": "ase_allelome_link_analysis_test_concordance_expr", "target": "ase_allelome_link_analysis_score_gained", "relation": "calls", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "ASE/Allelome_LINK.analysis.R", "source_location": "L535", "weight": 1.0}, {"source": "ase_allelome_link_analysis_test_concordance_expr", "target": "ase_allelome_link_analysis_score_lost", "relation": "calls", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "ASE/Allelome_LINK.analysis.R", "source_location": "L535", "weight": 1.0}, {"source": "ase_allelome_link_analysis_score_gained", "target": "ase_allelome_link_analysis_get_fc_row", "relation": "calls", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "ASE/Allelome_LINK.analysis.R", "source_location": "L486", "weight": 1.0}, {"source": "ase_allelome_link_analysis_score_lost", "target": "ase_allelome_link_analysis_get_fc_row", "relation": "calls", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "ASE/Allelome_LINK.analy